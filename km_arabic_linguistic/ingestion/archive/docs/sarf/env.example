# Copy to .env and set values. Do NOT commit .env.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=180
OPENAI_REASONING_EFFORT=low

# Embedding stack: ollama (local) or openai
EMBED_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Qdrant local on-disk (no docker required)
QDRANT_PATH=./data/qdrant_storage

# Pipeline scope - examples:
#   SARF_SCOPE=S1            (whole Surah 1)
#   SARF_SCOPE=S12:1-7       (ayahs 1..7 of Surah 12)
#   SARF_SCOPE=S73:4         (single ayah)
#   SARF_SCOPE=ALL           (entire Quran - WARNING: hours and significant cost)
SARF_SCOPE=S1

# Polite scrape rate for shamela.ws (seconds between requests, per host)
SHAMELA_SLEEP_SECONDS=1.5
SHAMELA_MAX_PAGES_PER_BOOK=400
SHAMELA_USER_AGENT=k-maps-research-bot/1.0 (academic morphology ingestion)

# Path to existing K-Maps repo root (for D1 SQL emission and reading qr_word_occurrences)
KMAPS_REPO_ROOT=/Users/abdulhasibahmedjadoon/Documents/LLM/knowledge-map
