          "head_word_index": 2,
          "note_ar": "جملة 'بدأت بأوعيتهم' تبدأ بفعل ماضي 'بدأ' مع الفاعل 'يوسف'، و'بأوعيتهم' جار ومجرور متعلق بفعل."
        },
        {
          "clause_order": 2,
          "clause_type": "adverbial_time",
          "word_start": 4,
          "word_end": 4,
          "head_word_index": 2,
          "note_ar": "الظرف الزماني 'قبل' منصوب متعلق بفعل 'بدأ'."
        },
        {
          "clause_order": 3,
          "clause_type": "main",
          "word_start": 5,
          "word_end": 7,
          "head_word_index": 6,
          "note_ar": "جملة 'استخرجها من وعاء أخيه' تبدأ بفعل مضارع 'استخرج' مع الفاعل 'الله'، و'ها' مفعول به."
        },
        {
          "clause_order": 4,
          "clause_type": "adverbial_place",
          "word_start": 8,
          "word_end": 10,
          "head_word_index": 6,
          "note_ar": "'من وعاء' جار ومجرور متعلق بفعل 'استخرجها'."
        },
        {
          "clause_order": 5,
          "clause_type": "conditional",
          "word_start": 11,
          "word_end": 13,
          "head_word_index": 12,
          "note_ar": "'كذلك' مرتبطة بجملة سابقة، و'كدنا' فعل ماضي مع الفاعل 'نا' مضاف إليه."
        },
        {
          "clause_order": 6,
          "clause_type": "object_clause",
          "word_start": 14,
          "word_end": 16,
          "head_word_index": 15,
          "note_ar": "'ما كان' جملة تعليلية، و'يأخذ' مضارع منصوب بأن."
        },
        {
          "clause_order": 7,
          "clause_type": "conditional",
          "word_start": 17,
          "word_end": 24,
          "head_word_index": 23,
          "note_ar": "'يأخذ' مضارع منصوب بأن، و'الله' فاعل مرفوع."
        },
        {
          "clause_order": 8,
          "clause_type": "main",
          "word_start": 25,
          "word_end": 33,
          "head_word_index": 25,
          "note_ar": "'نرفع درجات' فعل مضارع مرفوع، و'من نشاء' مفعول به، و'فوق كل ذي علم' ظرف مكان منصوب."
        }
