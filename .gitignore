# Node / Package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
pnpm-lock.yaml
# keep yarn.lock if you use Yarn; otherwise ignore lockfiles you don't use
# yarn.lock

# Build outputs
dist/
build/
.vite/
.cache/
.eslintcache
coverage/
**/*.js.map

# TypeScript / Angular
*.tsbuildinfo
.angular/
angular-compiler.db

# Cloudflare / Wrangler
.wrangler/
.worker/
*.wrangler/state*/
# functions/ is tracked (Cloudflare Pages Functions)
# D1 exports/dumps
*.sqlite
*.db
# track the canonical schema even though other SQL dumps stay ignored
*.sql
!database/schema.sql
!database/migrations/
!database/migrations/*.sql

# Env & secrets
.env
.env.*
.dev.vars

# Editors/OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/
*.js

# Angular cache
.angular/
**/.angular/
