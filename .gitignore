km_arabic_linguistic/ingestion/near_synonyms/sources/
# Track curated migrations and worker schema snapshots; keep ad hoc SQL dumps ignored.
*.sql
!database/migrations/
!database/migrations/*.sql
!database/migrations/**/*.sql
!database/seeds/
!database/seeds/*.sql
!database/seeds/**/*.sql
# Chunked seed splits are generated; too large for git
database/seeds/chunks/
!workers/*/schema.sql
!workers/*/migrations/
!workers/*/migrations/*.sql

